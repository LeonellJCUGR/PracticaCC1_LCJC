# ------------------------------------------------------------------
# RutaTicket - variables del entorno local (docker compose)
# ------------------------------------------------------------------
# Un contenedor de SQL Server por microservicio: cada uno tiene su contraseña de administrador (sa)
# y un login propio para la aplicación.
# SQL Server exige contraseñas de 8+ caracteres con mayúsculas, minúsculas, dígitos y símbolos.
# Se usan solo letras, dígitos y "_" o "-" (van dentro de una URL de conexión y de un script SQL).
CATALOG_SA_PASSWORD=Cambiar_SaCatalog_2026
CATALOG_DB_PASSWORD=Cambiar_Catalog_2026
BOOKING_SA_PASSWORD=Cambiar_SaBooking_2026
BOOKING_DB_PASSWORD=Cambiar_Booking_2026

# Memoria máxima (MB) que usará CADA INSTANCIA de SQL Server (2 instancias).
# 1536MB es suficiente para la práctica y además para que sea ligero; se hizo así para ahorrar memoria RAM.
MSSQL_MEMORY_LIMIT_MB=1536

# Puerto publicado en el host: el API Gateway es el único punto de entrada
GATEWAY_PORT=8080

# Zona horaria de las fechas de visita (RN-04 y RN-05)
APP_TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO

# Imágenes: por defecto se construyen en local. Para usar las publicadas por el CI:
#   IMAGE_PREFIX=ghcr.io/leonelljcugr/rutaticket  IMAGE_TAG=sha-<commit>  docker compose up -d --no-build
IMAGE_PREFIX=rutaticket
IMAGE_TAG=local
